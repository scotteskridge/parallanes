# parallanes configuration, read by its CLI, hooks and CI. Every key, with examples:
# docs/ai/kit-toml.md. Unknown keys are errors, so a typo can't silently switch a rule off.

[project]
name = "{{project_name}}"
test_command = "{{test_command}}"  # `lanes finish` and CI run it
integration_branch = "{{integration_branch}}"

# What agents may not edit, run, or read and edit. After a change here, run
# `{{kit_command}} settings sync`. What this stops and what it doesn't: docs/ai/protected-paths.md.
[protected]
paths = []  # e.g. ["vendor/**", "docs/originals/"]
commands = [
    "git push --force",
    "git push -f",
    "git reset --hard",
    "git clean -f",
    "git commit --no-verify",
    "git commit -n",
    "gh pr edit --add-label",
    "gh issue edit --add-label",
    "gh pr create --label",
    "gh pr create -l",
    "gh label edit",
    "gh alias set",
    "gh alias import",
    "gh pr merge --admin",
]
secrets = [".env", ".env.*", "!.env.example"]

# Forbidden code patterns, hook switches, shared paths and lanes: docs/ai/kit-toml.md.
# `{{kit_command}} lanes suggest` prints [[lanes]] tables guessed from the project's folders.
